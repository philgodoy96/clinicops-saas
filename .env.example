# Application
CLINICOPS_APP_NAME=ClinicOps SaaS
CLINICOPS_APP_VERSION=0.1.0
CLINICOPS_ENVIRONMENT=local
CLINICOPS_LOG_LEVEL=INFO

# Database URL used by the application and Alembic
CLINICOPS_DATABASE_URL=postgresql+psycopg://clinicops:clinicops@localhost:5432/clinicops
CLINICOPS_DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Authentication
CLINICOPS_AUTH_ISSUER=clinicops
CLINICOPS_AUTH_AUDIENCE=clinicops-api
CLINICOPS_AUTH_SIGNING_KEY=local-development-signing-key-change-me

# Billing webhook authentication
CLINICOPS_BILLING_WEBHOOK_SECRET=local-billing-webhook-secret-change-me
CLINICOPS_BILLING_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
CLINICOPS_BILLING_WEBHOOK_MAX_PAYLOAD_BYTES=262144

# Background worker runtime
# Leave CLINICOPS_WORKER_ID unset to generate hostname:pid:suffix identity.
# CLINICOPS_WORKER_ID=local-worker-1
CLINICOPS_WORKER_POLL_INTERVAL_SECONDS=1.0
CLINICOPS_WORKER_LEASE_SECONDS=300
CLINICOPS_WORKER_STALE_RECOVERY_INTERVAL_SECONDS=60
CLINICOPS_WORKER_STALE_RECOVERY_BATCH_SIZE=50
CLINICOPS_WORKER_RETRY_BASE_DELAY_SECONDS=30
CLINICOPS_WORKER_RETRY_MAXIMUM_DELAY_SECONDS=3600

# Local PostgreSQL container
POSTGRES_DB=clinicops
POSTGRES_USER=clinicops
POSTGRES_PASSWORD=clinicops
POSTGRES_PORT=5432

# Local user bootstrap
# Used only by: uv run python -m clinicops.cli.bootstrap_user
# These values are not required for API startup.
CLINICOPS_BOOTSTRAP_USER_EMAIL=
CLINICOPS_BOOTSTRAP_USER_PASSWORD=
